# Copy this file to .env and fill in real values. Never commit the real .env file.

# Server
PORT=5782

# MongoDB connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Cloudinary (image uploads)
cloud_name=your_cloudinary_cloud_name
api_key=your_cloudinary_api_key
api_secret=your_cloudinary_api_secret

# Outgoing email (nodemailer)
EMAIL_SERVICE=smtp.example.com
EMAIL_USERNAME=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@example.com

# Public URL of the deployed client app (used to build links sent in emails,
# e.g. the password-reset link)
CLIENT_URL=https://em-mern-social-app.vercel.app
